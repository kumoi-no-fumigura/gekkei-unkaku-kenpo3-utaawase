 "poems": [
  {
   "seq": "1",
   "text": "しのふよりこぬ秋をさへ知せけり末こす萩の野への夕かせ",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "人すまぬかた岡野への夏草はしけりにけりなおなしまに〓〓",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "玉ほこの道の夏草秋かけてかつ〓〓はらふ袖のしらつゆ",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "われのみそ露のなさけもかけてける月に分行庭の蓬生",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "秋の色を露につけてやかり枕しろくも袖にやとる月かな",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "つゆはまた荻の葉ならぬ風の色に月のみ秋の袖をしるかな",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "露分る夏野の草のぬれ衣なるとはすれと色もかはらす",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "夏草のみとりも深しいはしろの野邊のした草結ふ計に",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "かせの音の身にしむ色もかはらねと月に幾度秋を待らん",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "はたかねの小夜更かたに腹ふくれかせもすゝ!ふ月も秋なり",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "武藏野のはきや薄やほりたてゝ瓜やなすひや植てもたはや",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "かせやときまのゝ萩はら露をたにまたしらすけの同し綠に",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "空の色は秋をもまたぬ久堅の月のかつらやまつもみゆらん",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "しら露のゐなの笹はら分なれてやとるや月の秋の面かけ",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "岩代の野への夏くさしけれたゝ旅ねのまくら露むすふ迄",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "今はさはあとなき野への庵哉くさたつ迄そ人もまたれし",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "なつの夜の月にも秋は通ひけりかならす荻に風ふかねとも",
   "kana": "",
   "speaker": "",
   "page": 226,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "ほとゝきす聲みな月の山のはに秋をかけてや月のいつらん",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "をのつからこよひの空をみすしらて秋とか人の月を待らん",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "なつ衣ひとへにすゝむよはの月影はかはらぬ秋と見えつゝ",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "とし月はむなしき空の夕露にはてはちきりも朽ぬ袖哉",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "年へぬるその神山のゆふたすきかけて契し中やたえなん",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "つれなくて幾秋かせを契りきぬきさ山かけのまつとせしまに",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "はまひさし久しく成ぬ恨ても末の松山なみもこえつゝ",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "としをへてあはぬ契を菅原やひとりふしみのよその夕暮",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あとたえて果は淺ちに成ぬともたのめし宿の昔わするな",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "たのめ置し言のはとても枯果る野なる草木も春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "たのめてもおなしみとりの杉の庵のあれたに果ぬ山の奥哉",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "あはんとの空證文にいく夜へて數年になりぬこはいかにせん",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "徒にくちてや偖も山城のゐてのした帶むすほゝれつゝ",
   "kana": "",
   "speaker": "",
   "page": 227,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
